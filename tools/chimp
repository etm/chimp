#!/usr/bin/ruby

curpath = __FILE__
while ::File::symlink?(curpath)
  curpath = ::File::dirname(curpath) + '/' + ::File::readlink(curpath)
end
require 'optparse'
require_relative '../lib/ChimpParser'
require_relative '../lib/ChimpPlugin'
require_relative '../lib/ChimpParser-Grammar'

output = 'screen'
outputs = Dir[File.join(__dir__,'..','lib','output','*.rb')].map { |f| File.basename(f,'.rb') }.sort
ARGV.options { |opt|
  opt.summary_indent = ' ' * 2
  opt.banner = "Usage:\n#{opt.summary_indent}#{File.basename($0)} [options] [FILENAME]\n"
  opt.on("Options:")
  opt.on("--help", "-h", "This text") { puts opt; exit }
  opt.on("--output=NAME", "-o NAME", outputs, "Output: #{outputs.join(', ')} (default: screen)") { |o| output = o }
  opt.on("Filename needs to be a chimp presentation.")
  opt.parse!
} or exit 1 # nil on invalid options
if ARGV.length == 0 || !File.exist?(ARGV[0])
  puts ARGV.options
  exit
end

fname = File.realpath(ARGV[0])
grammy = Chimp::Parser::SimpleGrammar.parse File::read(fname), :fname => fname
require_relative "../lib/output/#{output}"
screen = Chimp::Parser.const_get(output.capitalize).new fname
grammy.prepare screen
grammy.output screen
